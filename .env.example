# Steam Web API key -- https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Bot token for the /report command bot (your own server)
# https://discord.com/developers/applications
COMMAND_BOT_TOKEN=

# Your personal Discord account token (the reporter)
USER_TOKEN=

# Target: the server + channel holding the "Create New Report" button
TARGET_GUILD_ID=560127830160048128
TARGET_CHANNEL_ID=1272990403393491025

# Filled in after discover.py runs
TICKET_MESSAGE_ID=
TICKET_BUTTON_CUSTOM_ID=
