# Copy to .env and fill in. .env is gitignored -- never commit it.
# See SETUP.md for how to obtain each value.

# --- Secrets ---------------------------------------------------------

# Steam Web API key -- https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Bot token for the /report command bot, running in your own server.
# https://discord.com/developers/applications
COMMAND_BOT_TOKEN=

# A Discord account token, used by the reporter to fill the form.
# Automating a user account breaks Discord's ToS and risks the account.
# Read the "Account risk" section of README.md before filling this in.
USER_TOKEN=

# --- Target ----------------------------------------------------------
# The server and channel holding the report button the reporter drives.
# Pre-filled with the default target; USER_TOKEN's account must be able
# to see that channel and use the button. To aim elsewhere, see SETUP.md
# step 6.
TARGET_GUILD_ID=560127830160048128
TARGET_CHANNEL_ID=1272990403393491025

# The message carrying the button, and that button's custom_id.
# If the target posts a new ticket message, `python discover.py` prints
# the new pair.
TICKET_MESSAGE_ID=1272991264941412412
TICKET_BUTTON_CUSTOM_ID=rust-cheater-report-button

# --- /report dropdown -----------------------------------------------
# Comma-separated server names offered in the /report `server` dropdown.
# "Custom" is always added, so this can stay blank. At most 24 names.
# Example: SERVER_CHOICES=EU Long,EU Medium,US Main
SERVER_CHOICES=

# --- Safety switch ---------------------------------------------------
# false = open and fill the form, then stop without submitting.
# Set true only when you intend to file real reports.
LIVE_SUBMIT=false

# --- Optional wipe reaction monitor ---------------------------------
# Set all three IDs to enable it on the same bot and in the same process.
# Copy IDs with Discord Developer Mode. The bot needs View Channel, Read
# Message History in the wipe channel and Send Messages in the admin channel.
WIPE_GUILD_ID=
WIPE_CHANNEL_ID=
WIPE_ADMIN_CHANNEL_ID=

# Optional. The systemd service stores state in /var/lib/reportingbot by default.
# WIPE_STATE_PATH=
